{
	"name": "@mikode13/harness-docs",
	"version": "0.0.0",
	"private": true,
	"description": "The design of the MiKode harness product, across its projects.",
	"license": "CC-BY-4.0",
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"prepare": "mikode-git-hooks install",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint:markdown": "markdownlint-cli2 README.md AGENTS.md mvp.md glossary.md \"design/**/*.md\" \"docs/**/*.md\" \"flows/**/*.md\"",
		"links:internal": "remark --quiet --frail --use remark-validate-links .",
		"docs:check": "pnpm run format:check && pnpm run lint:markdown && pnpm run links:internal"
	},
	"devDependencies": {
		"@mikode13/code-style": "1.0.0",
		"@mikode13/git-hooks": "1.0.0",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.6",
		"remark-cli": "12.0.1",
		"remark-validate-links": "13.1.0"
	}
}
